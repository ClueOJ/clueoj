+    def pause(path, value):
+        original(path, value)
+        if path.parent.name.startswith('.staging-'):
+            staged.set()
+            threading.Event().wait(30)
+
+    with patch.object(remote_data, '_json_write', side_effect=pause):
+        with remote_data.prepare(meta, cache, allow_http=True, timeout=10):
+            pass
