+import io
+import json
+import threading
+import unittest
+import zlib
+from types import SimpleNamespace
+from unittest.mock import Mock, patch
+
+from dmoj.judgeenv import env
+from dmoj.packet import PacketManager
+from dmoj.utils.remote_data import CAPABILITY
+
+
+class PacketIdentityTests(unittest.TestCase):
+    def manager(self, current=None):
+        manager = object.__new__(PacketManager)
+        manager.judge = SimpleNamespace(current_submission=current, abort_grading=Mock())
+        manager.conn = Mock()
+        manager._closed = True
+        manager._lock = threading.RLock()
+        return manager
+
+    def sent_packet(self, manager):
+        raw = manager.conn.sendall.call_args[0][0]
+        return json.loads(zlib.decompress(raw[4:]))
+
+    def test_handshake_works_before_judge_worker_is_initialized(self):
+        class StartingJudge:
+            @property
+            def current_submission(self):
+                raise AssertionError('No worker exists during handshake')
+
+        manager = self.manager()
+        manager.judge = StartingJudge()
+        manager._send_packet({'name': 'handshake'})
+        self.assertEqual(self.sent_packet(manager), {'name': 'handshake'})
+
+    def test_remote_capability_is_advertised_with_empty_inventory(self):
+        for cache in (None, '/tmp/verified-cache'):
+            manager = self.manager()
+            manager.host, manager.port = 'localhost', 9999
+            response = zlib.compress(json.dumps({'name': 'handshake-success'}).encode())
+            manager.input = io.BytesIO(PacketManager.SIZE_PACK.pack(len(response)) + response)
+            with patch.dict(env.raw_config, {'remote_data_cache': cache}):
+                manager.handshake([], {}, 'test-judge', 'test-key')
+            packet = self.sent_packet(manager)
+            self.assertEqual(packet['problems'], [])
+            self.assertEqual(packet.get('capabilities'), [CAPABILITY] if cache else None)
+
+    def test_result_echoes_the_identity_of_its_run(self):
+        manager = self.manager(SimpleNamespace(id=42, meta={'dispatch-id': 'run-a'}))
+        manager._send_packet({'name': 'grading-end', 'submission-id': 42})
+        self.assertEqual(self.sent_packet(manager)['dispatch-id'], 'run-a')
+
+    def test_explicit_ack_identity_is_not_replaced_by_previous_run(self):
+        manager = self.manager(SimpleNamespace(id=42, meta={'dispatch-id': 'old'}))
+        manager._send_packet({'name': 'submission-acknowledged', 'submission-id': 42, 'dispatch-id': 'new'})
+        self.assertEqual(self.sent_packet(manager)['dispatch-id'], 'new')
+
+    def test_delayed_abort_does_not_kill_new_run_of_same_submission(self):
+        manager = self.manager(SimpleNamespace(id=42, meta={'dispatch-id': 'new'}))
+        manager._receive_packet({'name': 'terminate-submission', 'submission-id': 42, 'dispatch-id': 'old'})
+        manager.judge.abort_grading.assert_not_called()
+        manager._receive_packet({'name': 'terminate-submission', 'submission-id': 42, 'dispatch-id': 'new'})
+        manager.judge.abort_grading.assert_called_once_with(42)
