+        class Handler(BaseHTTPRequestHandler):
+            def log_message(self, *args):
+                pass
+
+            def do_POST(self):
+                body = json.loads(self.rfile.read(int(self.headers['Content-Length'])))
+                sha = body['ticket']
+                if not fixture.active:
+                    self.send_error(409)
+                    return
+                result = {'sha256': sha, 'downloads': {}}
+                if not body.get('paths'):
+                    result['manifest'] = fixture.manifests[sha]
+                for path in body.get('paths', []):
+                    content = fixture.latest[path]
+                    key = hashlib.sha256(content).hexdigest()
+                    fixture.objects[key] = b'x' * len(content) if fixture.corrupt else content
+                    fixture.downloads.append(path)
+                    result['downloads'][path] = {'url': fixture.base_url + '/objects/' + key}
+                payload = json.dumps(result).encode()
+                self.send_response(200)
+                self.end_headers()
+                self.wfile.write(payload)
