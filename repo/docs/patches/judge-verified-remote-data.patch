+"""Verified persistent datasets; grading keeps a shared lock until cleanup."""
+import fcntl
+import hashlib
+import json
+import os
+import re
+import shutil
+import tempfile
+import time
+import uuid
+from contextlib import ExitStack, contextmanager
+from pathlib import Path, PurePosixPath
+from urllib.error import HTTPError, URLError
+from urllib.parse import urlsplit
+from urllib.request import HTTPRedirectHandler, Request, build_opener
+
+CAPABILITY = 'problem-data-manifest-v1'
+# Imported in the controller before forking. Recheck persisted bytes once per
+# controller session; its subsequent workers reuse the protected verification.
+_SESSION = uuid.uuid4().hex
+
+
+class RemoteDataError(Exception):
+    pass
+
+
+class RemoteDataAborted(RemoteDataError):
+    pass
+
+
+class _NoRedirect(HTTPRedirectHandler):
+    def redirect_request(self, req, fp, code, msg, headers, newurl):
+        return None
+
+
+def manifest_digest(manifest):
+    return hashlib.sha256(
+        json.dumps(manifest, sort_keys=True, separators=(',', ':'), ensure_ascii=True).encode()
+    ).hexdigest()
+
+
+def _validate(manifest, meta):
+    if (
+        not isinstance(manifest, dict)
+        or manifest.get('version') != 1
+        or manifest.get('problem_id') != meta['root']
+        or manifest_digest(manifest) != meta['sha256']
+    ):
+        raise RemoteDataError('Grading manifest identity does not match the requested version.')
+    files = manifest.get('files')
+    if not isinstance(files, list) or not files:
+        raise RemoteDataError('Empty grading manifest.')
+    seen = set()
+    for entry in files:
+        path = entry['path']
+        if (
+            not isinstance(path, str)
+            or not path
+            or '\x00' in path
+            or '\\' in path
+            or PurePosixPath(path).is_absolute()
+            or str(PurePosixPath(path)) != path
+            or '..' in PurePosixPath(path).parts
+            or path in seen
+            or not re.fullmatch('[0-9a-f]{64}', entry['sha256'])
+            or not isinstance(entry['size'], int)
+            or entry['size'] < 0
+            or not isinstance(entry['mode'], int)
+            or entry['mode'] & ~0o777
+            or entry['kind'] not in ('file', 'symlink')
+        ):
+            raise RemoteDataError('Invalid grading manifest entry.')
+        seen.add(path)
+    if 'init.yml' not in seen:
+        raise RemoteDataError('Grading manifest has no init.yml.')
+
+
+def _fsync_dir(path):
+    descriptor = os.open(str(path), os.O_RDONLY)
+    try:
+        os.fsync(descriptor)
+    finally:
+        os.close(descriptor)
+
+
+def _json_write(path, value):
+    fd, temporary = tempfile.mkstemp(dir=str(path.parent), prefix='.state-')
+    try:
+        with os.fdopen(fd, 'w') as stream:
+            json.dump(value, stream, sort_keys=True)
+            stream.flush()
+            os.fsync(stream.fileno())
+        os.replace(temporary, path)
+        _fsync_dir(path.parent)
+    finally:
+        if os.path.exists(temporary):
+            os.unlink(temporary)
+
+
+def _state(current):
+    try:
+        with (current / 'state.json').open() as stream:
+            value = json.load(stream)
+        if (
+            not isinstance(value, dict)
+            or not isinstance(value.get('manifest'), dict)
+            or not isinstance(value['manifest'].get('files'), list)
+            or not isinstance(value.get('sessions'), list)
+            or manifest_digest(value['manifest']) != value.get('sha256')
+        ):
+            return {}
+        return value
+    except (OSError, ValueError, RuntimeError):
+        return {}
+
+
+class _Preparation:
+    def __init__(self, meta, aborted, timeout, allow_http):
+        self.meta = meta
+        self.aborted = aborted
+        self.deadline = time.monotonic() + timeout
+        self.allow_http = allow_http
+        self.opener = build_opener(_NoRedirect())
+
+    def checkpoint(self):
+        if self.aborted():
+            raise RemoteDataAborted('Grading-data preparation was cancelled.')
+        if time.monotonic() >= self.deadline:
+            raise RemoteDataError('Grading-data preparation timed out.')
+
+    def lock(self, stream, mode):
+        while True:
+            self.checkpoint()
+            try:
+                fcntl.flock(stream.fileno(), mode | fcntl.LOCK_NB)
+                return
+            except BlockingIOError:
+                time.sleep(0.05)
+
+    def open(self, url, body=None):
+        self.checkpoint()
+        parsed = urlsplit(url)
+        if (
+            parsed.scheme not in (('https', 'http') if self.allow_http else ('https',))
+            or not parsed.netloc
+            or parsed.username
+            or parsed.password
+            or parsed.fragment
+        ):
+            raise RemoteDataError('Grading data requires a trusted HTTPS URL.')
+        request = Request(
+            url,
+            data=json.dumps(body).encode() if body is not None else None,
+            headers={'Content-Type': 'application/json'} if body is not None else {},
+        )
+        try:
+            return self.opener.open(request, timeout=min(10, max(0.1, self.deadline - time.monotonic())))
+        except (HTTPError, URLError, OSError):
+            # Never log signed URLs or tickets through an HTTP exception.
+            raise RemoteDataError('Grading-data request failed.') from None
+
+    def request(self, paths=()):
+        with self.open(self.meta['url'], {'ticket': self.meta['ticket'], 'paths': list(paths)}) as response:
+            chunks, size = [], 0
+            while size <= 16 * 1024 * 1024:
+                self.checkpoint()
+                chunk = response.read1(65536)
+                if not chunk:
+                    break
+                chunks.append(chunk)
+                size += len(chunk)
+            content = b''.join(chunks)
+        self.checkpoint()
+        if len(content) > 16 * 1024 * 1024:
+            raise RemoteDataError('Grading manifest response is too large.')
+        try:
+            result = json.loads(content)
+            if result['sha256'] != self.meta['sha256']:
+                raise RemoteDataError('OJ returned a different grading-data version.')
+            return result
+        except (ValueError, KeyError, TypeError):
+            raise RemoteDataError('Invalid grading-data response.') from None
+
+    def copy(self, source, target, entry):
+        digest, size = hashlib.sha256(), 0
+        with source, target.open('wb') as output:
+            read = getattr(source, 'read1', source.read)
+            while True:
+                self.checkpoint()
+                chunk = read(1024 * 1024)
+                if not chunk:
+                    break
+                size += len(chunk)
+                if size > entry['size']:
+                    raise RemoteDataError('Grading-data size does not match its manifest.')
+                digest.update(chunk)
+                output.write(chunk)
+            output.flush()
+            os.fsync(output.fileno())
+        if size != entry['size'] or digest.hexdigest() != entry['sha256']:
+            raise RemoteDataError('Grading-data checksum does not match its manifest.')
+
+    def download(self, target, entry):
+        for attempt in range(2):
+            try:
+                result = self.request([entry['path']])
+                with self.open(result['downloads'][entry['path']]['url']) as response:
+                    self.copy(response, target, entry)
+                return
+            except RemoteDataAborted:
+                raise
+            except (RemoteDataError, OSError, KeyError, TypeError):
+                if attempt:
+                    raise RemoteDataError('Could not obtain verified grading data.') from None
+
+    def verify(self, data, manifest):
+        expected = {entry['path']: entry for entry in manifest['files']}
+        actual = set()
+        for directory, dirs, names in os.walk(data, followlinks=False):
+            links = [name for name in dirs if (Path(directory) / name).is_symlink()]
+            dirs[:] = [name for name in dirs if name not in links]
+            for name in names + links:
+                self.checkpoint()
+                path = Path(directory) / name
+                relative = path.relative_to(data).as_posix()
+                actual.add(relative)
+                entry = expected.get(relative)
+                if entry is None:
+                    return False
+                if entry['kind'] == 'symlink':
+                    if not path.is_symlink() or os.readlink(path) != entry['target']:
+                        return False
+                    content = entry['target'].encode()
+                    size, digest = len(content), hashlib.sha256(content)
+                else:
+                    if path.is_symlink() or not path.is_file() or (path.stat().st_mode & 0o777) != entry['mode']:
+                        return False
+                    digest, size = hashlib.sha256(), 0
+                    with path.open('rb') as stream:
+                        for chunk in iter(lambda: stream.read(1024 * 1024), b''):
+                            self.checkpoint()
+                            digest.update(chunk)
+                            size += len(chunk)
+                if size != entry['size'] or digest.hexdigest() != entry['sha256']:
+                    return False
+        return actual == set(expected)
+
+
+@contextmanager
+def _staging_guard(base, prep):
+    # Serialize directory creation with collection, including the interval before
+    # the creator has opened its lease. Never acquire the dataset lock here.
+    with (base / 'staging.lock').open('a+b') as guard:
+        prep.lock(guard, fcntl.LOCK_EX)
+        yield
+
+
+def _clean_staging(base, prep):
+    with _staging_guard(base, prep):
+        for candidate in base.glob('.staging-*'):
+            prep.checkpoint()
+            if candidate.is_symlink() or not candidate.is_dir():
+                continue
+            try:
+                with (candidate / '.owner.lock').open('a+b') as lease:
+                    try:
+                        fcntl.flock(lease.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
+                    except BlockingIOError:
+                        continue  # A live preparation owns this directory.
+                    shutil.rmtree(candidate)
+            except FileNotFoundError:
+                # An active preparation may have published by renaming its
+                # directory while we were opening/checking the lease.
+                continue
+
+
+def _new_staging(base, prep, leases):
+    with _staging_guard(base, prep):
+        staging = Path(tempfile.mkdtemp(prefix='.staging-', dir=str(base)))
+        try:
+            lease = leases.enter_context((staging / '.owner.lock').open('a+b'))
+            prep.lock(lease, fcntl.LOCK_EX)
+        except BaseException:
+            shutil.rmtree(staging, ignore_errors=True)
+            raise
+        return staging
+
+
+@contextmanager
+def prepare(meta, cache_root, aborted=lambda: False, timeout=1800, allow_http=False):
+    """Publish under EX; recheck M under SH, keeping SH through caller cleanup."""
+    if not cache_root or not isinstance(meta.get('root'), int) or meta['root'] <= 0:
+        raise RemoteDataError('Remote grading cache is not configured.')
+    prep = _Preparation(meta, aborted, timeout, allow_http)
+    base = Path(cache_root) / str(meta['root'])
+    current, old = base / 'current', base / 'previous'
+    staging, grading = None, False
+    try:
+        base.mkdir(parents=True, exist_ok=True)
